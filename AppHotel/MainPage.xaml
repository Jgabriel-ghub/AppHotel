<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.MainPage"
             Title="AppHotel" BackgroundColor="#F1F5F9">
    <ScrollView>
        <VerticalStackLayout Padding="22,28" Spacing="17" MaximumWidthRequest="650">
            <Border BackgroundColor="#1E3A8A" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="24">
                <VerticalStackLayout Spacing="7">
                    <Label Text="APPHOTEL  |  AGENDA 14" TextColor="#BFDBFE" FontAttributes="Bold" FontSize="12" />
                    <Label Text="Sua hospedagem, sem complicação" TextColor="White" FontAttributes="Bold" FontSize="26" />
                    <Label Text="Escolha o quarto e personalize sua estadia." TextColor="#DBEAFE" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeShape="RoundRectangle 15" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Dados da reserva" TextColor="#0F172A" FontAttributes="Bold" FontSize="21" />
                    <Label Text="Tipo de quarto" TextColor="#334155" FontAttributes="Bold" />
                    <Picker x:Name="pck_quarto" Title="Selecione um quarto"
                            TitleColor="#64748B" TextColor="#0F172A"
                            ItemDisplayBinding="{Binding Descricao}"
                            SelectedItem="{Binding QuartoSelecionado, Mode=TwoWay}" />

                    <Label Text="Quantidade de hóspedes" TextColor="#334155" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding QuantidadeHospedes, StringFormat='Hóspedes: {0:F0}'}"
                               TextColor="#0F172A" VerticalOptions="Center" />
                        <Stepper Grid.Column="1" Minimum="1" Maximum="10" Increment="1"
                                 Value="{Binding QuantidadeHospedes, Mode=TwoWay}" />
                    </Grid>

                    <Label Text="Data de entrada" TextColor="#334155" FontAttributes="Bold" />
                    <DatePicker x:Name="dtp_entrada" Date="{Binding DataEntrada, Mode=TwoWay}"
                                DateSelected="OnEntradaDateSelected" Format="dd/MM/yyyy" TextColor="#0F172A" />
                    <Label Text="Data de saída" TextColor="#334155" FontAttributes="Bold" />
                    <DatePicker x:Name="dtp_saida" Date="{Binding DataSaida, Mode=TwoWay}"
                                DateSelected="OnSaidaDateSelected" Format="dd/MM/yyyy" TextColor="#0F172A" />
                    <Label Text="A saída deve ser posterior à entrada." TextColor="#64748B" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeShape="RoundRectangle 15" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Prévia da hospedagem" FontSize="19" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="{Binding Diarias, StringFormat='Duração: {0} diária(s)'}" TextColor="#334155" />
                    <Label Text="{Binding ValorDiariaFormatado, StringFormat='Valor por hóspede / diária: {0}'}" TextColor="#64748B" FontSize="13" />
                    <Label Text="{Binding TotalFormatado}" TextColor="#1D4ED8" FontAttributes="Bold" FontSize="30" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Calcular hospedagem" Clicked="OnCalcularClicked"
                    BackgroundColor="#2563EB" TextColor="White" CornerRadius="11" HeightRequest="52" />
            <Button Text="Sobre o aplicativo" Clicked="OnSobreClicked"
                    BackgroundColor="#DBEAFE" TextColor="#1E3A8A" CornerRadius="11" HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
