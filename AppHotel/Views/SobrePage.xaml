<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.SobrePage"
             Title="Sobre" BackgroundColor="#F4F7FA">
    <ScrollView>
        <VerticalStackLayout Padding="22,28" Spacing="18" MaximumWidthRequest="650">
            <Label Text="Sobre" FontAttributes="Bold" FontSize="30" TextColor="#183044" />
            <Label Text="Conheça o aplicativo e seu desenvolvedor." FontSize="14" TextColor="#60778C" />
            <Border BackgroundColor="White" Stroke="#DFE6ED" StrokeShape="RoundRectangle 14" Padding="22">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Recuperação - Agenda 13" FontSize="20" FontAttributes="Bold" TextColor="#183044" />
                    <Label Text="Aplicativo de simulação de hospedagem desenvolvido com .NET MAUI, XAML e C#." TextColor="#183044" />
                    <BoxView HeightRequest="1" Color="#DFE6ED" />
                    <Label Text="Desenvolvedor" FontAttributes="Bold" TextColor="#087D88" />
                    <Label Text="Joao Gabriel" TextColor="#183044" />
                    <Label Text="Curso" FontAttributes="Bold" TextColor="#087D88" />
                    <Label Text="Técnico em Desenvolvimento de Sistemas" TextColor="#183044" />
                    <Label Text="Tecnologias" FontAttributes="Bold" TextColor="#087D88" />
                    <Label Text=".NET MAUI • C# • XAML • BindingContext" TextColor="#183044" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Voltar" Clicked="OnVoltarClicked" BackgroundColor="#087D88" TextColor="White" CornerRadius="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
